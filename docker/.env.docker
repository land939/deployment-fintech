# Docker environment configuration for GTA Fintech Platform
# Copy to .env or use with: docker-compose --env-file docker/.env.docker up

# === ENVIRONMENT ===
ENVIRONMENT=docker
DEBUG=false

# === DATABASE ===
DB_USER=gta_user
DB_PASSWORD=gta_password
DB_NAME=gta_fintech
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://gta_user:gta_password@postgres:5432/gta_fintech

# === REDIS ===
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# === API ===
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# === SUPERADMIN ===
SUPERADMIN_EMAIL=admin@fintech.local
SUPERADMIN_PASSWORD=SecurePassword123!

# === EMAIL (SMTP) ===
MAIL_SERVER=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@fintech.local

# === BLOCKCHAIN ===
RPC_URL=http://localhost:8545
CONTRACT_ADDRESS=

# === LOGGING ===
LOG_LEVEL=INFO

# === ML/AI ===
MODEL_PATH=/app/models/fraud_detector.pkl
SCALER_PATH=/app/models/scaler.pkl
FEATURE_COLUMNS_PATH=/app/models/feature_columns.json
